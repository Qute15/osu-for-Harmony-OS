<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HarmonyOS platform layer for osu!framework (route A, NativeAOT).

    Unlike osu.Framework.Android this is a plain net10.0 library: there is no
    HarmonyOS TFM, and the final binary is produced by .NET NativeAOT for
    linux-musl-arm64 / linux-musl-x64 using the OHOS clang from DevEco Studio.

    It references the framework SOURCE project (output/fw/osu.Framework), not the
    ppy.osu.Framework NuGet package, because:
      * SDL3MobileWindow / SDL3Window are internal -> needs InternalsVisibleTo,
      * the BASS audio backend must be replaced for OHOS later (R1).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>osu.Framework.OHOS</AssemblyName>
    <RootNamespace>osu.Framework.OHOS</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Local osu.Framework source checkout (with harmonyos/patches/osu.framework applied). -->
    <OsuFrameworkSourceDir Condition="'$(OsuFrameworkSourceDir)' == ''">$(MSBuildThisFileDirectory)../osu.Framework</OsuFrameworkSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(OsuFrameworkSourceDir)/osu.Framework/osu.Framework.csproj" />
  </ItemGroup>
</Project>
